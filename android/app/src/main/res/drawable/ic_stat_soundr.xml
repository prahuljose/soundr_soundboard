<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome notification small icon: 7 equalizer bars (white on transparent).
     Android 5+ uses only the alpha channel for status-bar icons. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- 7 bars, centred, symmetric, proportional to the launcher icon -->
  <!-- bar w=2.2dp, gap=1.1dp, total width≈21dp, left edge≈1.5dp -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="
        M1.5,13 h2.2 v4   h-2.2 z
        M4.8,10 h2.2 v7   h-2.2 z
        M8.1,7  h2.2 v10  h-2.2 z
        M11.4,5 h2.2 v14  h-2.2 z
        M14.7,7 h2.2 v10  h-2.2 z
        M18.0,10 h2.2 v7  h-2.2 z
        M21.3,13 h2.2 v4  h-2.2 z
      "/>
</vector>
