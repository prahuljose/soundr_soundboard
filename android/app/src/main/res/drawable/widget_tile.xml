<?xml version="1.0" encoding="utf-8"?>
<!-- One sound button inside the widget, brighter while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#667C3AED" />
            <stroke android:width="1dp" android:color="#CCA78BFA" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1dp" android:color="#40A78BFA" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
