<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 by default (header + eight buttons); shrink to one row for a
     header + four buttons, or to the smallest height for just the buttons.
     previewLayout (Android 12+) renders the layout's default preview content. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_quick_sounds"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_quick_sounds"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
